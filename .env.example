# Plantilla de variables de entorno.
# Copia este archivo a un archivo llamado «.env» y rellena el valor.
# El «.env» real está en .gitignore y NO se sube al repositorio.

# Clave de API de Groq (necesaria para la generación de informes con el LLM).
# Consíguela gratis en https://console.groq.com/keys
GROQ_API_KEY=
